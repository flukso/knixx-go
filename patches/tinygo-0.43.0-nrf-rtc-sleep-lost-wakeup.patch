--- a/src/runtime/runtime_nrf.go	2026-10-27 14:03:16
+++ b/src/runtime/runtime_nrf.go	2026-10-27 14:03:16
@@ -133,8 +133,14 @@
 var rtc_wakeup volatile.Register8
 
 func rtc_sleep(ticks uint32) {
-	nrf.RTC1.INTENSET.Set(nrf.RTC_INTENSET_COMPARE0)
+	// Clear the wakeup flag and a stale COMPARE0 event before the interrupt
+	// is enabled, not after: with an event pending, enabling the interrupt
+	// runs the handler at once, which sets rtc_wakeup and disables the
