+		// Should COMPARE0 be missed anyway, stop once COUNTER is past the
+		// target; the RTC overflow interrupt wakes the CPU at least every
+		// 512 s.
+		if (nrf.RTC1.COUNTER.Get()-target)&0x00ffffff < 0x800000 {
+			return
+		}
